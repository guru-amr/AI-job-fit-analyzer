    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst html = $json.data || \"\";\n\n// Remove HTML tags\nconst text = html\n  .replace(/<[^>]*>/g, \" \")\n  .replace(/\\s+/g, \" \");\n\n// Extract main job description\nconst match = text.match(/Job Summary:(.*?)Similar jobs/i);\n\nconst cleaned = match\n  ? match[1].trim()\n  : text.substring(0, 3000);\n\nreturn [\n  {\n    cleaned_html: cleaned\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        112,
